{
  "name": "sudya-ty-chego-multiplayer",
  "version": "2.1.0",
  "private": true,
  "description": "Хоккейная викторина ЦСКА — Динамо на разных телефонах",
  "scripts": {
    "start": "node dist/server/main.js",
    "dev": "node scripts/dev.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.tools.json",
    "lint": "eslint src tests *.config.ts",
    "format": "prettier --write src tests scripts *.config.* tsconfig.*.json package.json",
    "format:check": "prettier --check src tests scripts *.config.* tsconfig.*.json package.json",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:client": "vite",
    "dev:api": "tsx watch src/server/main.ts --dev",
    "dev:types:server": "tsc -p tsconfig.server.json --noEmit --watch --preserveWatchOutput",
    "dev:types:client": "tsc -p tsconfig.client.json --watch --preserveWatchOutput",
    "build": "node scripts/build.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:release": "node scripts/check-release.mjs && node scripts/check-release.mjs --sigint"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.1",
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
